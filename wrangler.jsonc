{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rifa-videira-kids",
  "main": "./src/worker/index.ts",
  // Não passe da data suportada pelo workerd instalado (o wrangler avisa se passar).
  "compatibility_date": "2026-11-01",
  "observability": {
    "enabled": true,
  },
  // Site React servido pelo mesmo Worker (Workers Static Assets). O diretório dos
  // assets (dist/client) é definido pelo @cloudflare/vite-plugin no build.
  "assets": {
    // Rota desconhecida do site devolve o index.html (o React decide o que mostrar).
    "not_found_handling": "single-page-application",
    // /api/* vai sempre para o Worker (Hono), nunca para os assets.
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rifa-videira-kids",
      // Placeholder: preencher quando a conta Cloudflare existir
      // (`npx wrangler d1 create rifa-videira-kids` devolve o id real).
      // Em desenvolvimento e nos testes o banco é local e este valor não importa.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
}
