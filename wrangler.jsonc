{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rifa-videira-kids",
  "main": "./src/worker/index.ts",
  // Não passe da data suportada pelo workerd instalado (o wrangler avisa se passar).
  "compatibility_date": "2026-11-01",
  "observability": {
    "enabled": true,
  },
  // Site React servido pelo mesmo Worker (Workers Static Assets). O diretório dos
  // assets (dist/client) é definido pelo @cloudflare/vite-plugin no build.
  "assets": {
    // Rota desconhecida do site devolve o index.html (o React decide o que mostrar).
    "not_found_handling": "single-page-application",
    // /api/* vai sempre para o Worker (Hono), nunca para os assets.
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rifa-videira-kids",
      // Banco de produção na conta Cloudflare do Thiago (região ENAM), criado em 06/11/2026.
      // Em desenvolvimento e nos testes o banco é local e este valor não é usado.
      "database_id": "256a7113-3b0d-4ae9-af73-45c2d279a9c7",
      "migrations_dir": "migrations",
    },
  ],
}
