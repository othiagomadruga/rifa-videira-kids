# Variáveis e segredos do Worker em desenvolvimento local.
# Copie para .dev.vars (ignorado pelo git) e troque os valores; nunca versione o .dev.vars.
# Em produção, cadastre cada segredo com: npx wrangler secret put <NOME>

# Token que autentica o webhook de pedidos da Rifei. Vale só enquanto não houver token gerado pela tela
# da coordenação no D1 local (o da tela tem prioridade: docs/decisions.md, D21).
RIFEI_WEBHOOK_TOKEN=troque-me

# Token do login na Rifei para a API interna do painel (RIFA-070, D32): marcar pagos na Rifei, afiliados e
# convites. É a alternativa ao token colado na tela (Acessos → Conexão com a Rifei), que tem prioridade.
# No dev, deixe vazio ou use uma conta de teste.
RIFEI_API_TOKEN=

# Chave que cifra no D1 o token colado na tela (RIFA-070, D32): ao menos 32 caracteres aleatórios
# (`openssl rand -base64 32`). Sem ela, a tela de Conexão com a Rifei não guarda o token.
RIFEI_CHAVE_CIFRA=troque-me-por-uma-chave-aleatoria-de-32-caracteres
